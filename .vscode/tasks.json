{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Deploy Code (rsync)",
            "type": "shell",
            "command": "rsync",
            "args": [
                "-avz",
                "--delete",
                "--exclude-from=${workspaceFolder}/.gitignore",
                "--exclude='.git/'",
                "--exclude='.vscode/'",
                "${workspaceFolder}/",
                "chris@192.168.2.40:/home/chris/jukebox/"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Sync Music Directory (rsync)",
            "type": "shell",
            "command": "rsync",
            "args": [
                "-avz",
                "--delete",
                "${workspaceFolder}/music/",
                "chris@192.168.2.40:/home/chris/jukebox/music/"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}